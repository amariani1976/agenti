#!/usr/bin/env python3
"""Esecutore del comando agente: avvia pi con un profilo specifico."""
import argparse
import importlib.util
import json
import os
import re
import subprocess
import sys

# Predefiniti
DEFAULT_PI = os.path.expanduser('~/.local/bin/pi')
# La radice è la cartella sopra bin/
DEFAULT_RADICE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Regex per nome valido: inizia con lettera minuscola, poi 0-40 caratteri (lettera minuscola, cifra, trattino)
NOME_VALIDO = re.compile(r'^[a-z][a-z0-9-]{0,40}$')


def _profilo_dir(radice, nome):
    """Restituisce il percorso della cartella del profilo."""
    return os.path.join(radice, 'profili', nome)


def _strumenti(radice, nome):
    """Legge gli strumenti dal file strumenti del profilo."""
    path = os.path.join(_profilo_dir(radice, nome), 'strumenti')
    if not os.path.exists(path):
        return []
    with open(path, 'r') as f:
        return [s.strip() for s in f.read().strip().split(',') if s.strip()]


def _skills(radice, nome):
    """Restituisce la lista delle skill (cartelle con SKILL.md) in ordine alfabetico."""
    skills_dir = os.path.join(_profilo_dir(radice, nome), 'skills')
    if not os.path.isdir(skills_dir):
        return []
    result = []
    for entry in os.listdir(skills_dir):
        path = os.path.join(skills_dir, entry)
        if os.path.isdir(path) and os.path.exists(os.path.join(path, 'SKILL.md')):
            result.append((entry, path))
    # Ordina per nome (prima parte del percorso)
    result.sort(key=lambda x: x[0])
    return [p for _, p in result]


def comando(nome, compito, cartella, radice, pi=DEFAULT_PI):
    """
    Costruisce il comando per eseguire pi con il profilo specificato.

    Args:
        nome: nome del profilo (deve essere valido)
        compito: il compito da eseguire
        cartella: cartella di lavoro (cwd)
        radice: radice del progetto (dove si trovano i profili)
        pi: percorso al programma pi (default: DEFAULT_PI)

    Returns:
        tuple (argv, env, cwd) dove:
        - argv: lista di argomenti per subprocess.run
        - env: dizionario delle variabili d'ambiente
        - cwd: cartella di lavoro

    Raises:
        ValueError: se il nome non è valido o il profilo non esiste
    """
    # Validazione nome
    if not NOME_VALIDO.match(nome):
        raise ValueError(f"nome non valido: '{nome}' (deve corrispondere a {NOME_VALIDO.pattern})")

    profilo = _profilo_dir(radice, nome)
    if not os.path.isdir(profilo):
        raise ValueError(f"profilo non esistente: '{nome}'")

    # Costruisci argv
    argv = [pi, '-p', '--no-session', '--no-skills']

    # Aggiungi skill in ordine alfabetico
    for skill_path in _skills(radice, nome):
        argv.extend(['--skill', skill_path])

    # Aggiungi strumenti
    tools = _strumenti(radice, nome)
    if tools:
        argv.extend(['--tools', ','.join(tools)])

    # Aggiungi il compito
    argv.append(' '.join(compito) if isinstance(compito, list) else compito)

    # Ambiente con solo PI_CODING_AGENT_DIR
    env = {'PI_CODING_AGENT_DIR': profilo}

    return argv, env, cartella


def _stampa_json(dato):
    """Stampa un dizionario come JSON."""
    print(json.dumps(dato, indent=2, sort_keys=True))


def _esegui_con_verifica(file_arg, verifica_arg, tentativi_arg, nome, compito, cartella, radice, pi):
    """Esegue l'agente con verifica usando ciclo.esegui."""
    # Importa i moduli ciclo senza modificare sys.path globale
    ciclo_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'ciclo')
    # Carica il modulo ciclo/ciclo.py come "ciclo"
    spec = importlib.util.spec_from_file_location("ciclo", os.path.join(ciclo_path, 'ciclo.py'))
    ciclo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(ciclo)
    # Carica anche esecuzione.py e aggiungi Esecuzione al modulo ciclo
    exec_spec = importlib.util.spec_from_file_location("ciclo.esecuzione", os.path.join(ciclo_path, 'esecuzione.py'))
    exec_module = importlib.util.module_from_spec(exec_spec)
    exec_spec.loader.exec_module(exec_module)
    ciclo.Esecuzione = exec_module.Esecuzione

    # Costruisci lista file con validazione path traversal
    file_list = []
    for f in file_arg.split(','):
        f = f.strip()
        if f:
            # Risolvi il percorso relativo rispetto a radice e verifica path traversal
            abs_path = os.path.normpath(os.path.join(radice, f))
            radice_abs = os.path.abspath(radice)
            if not abs_path.startswith(radice_abs + os.sep) and abs_path != radice_abs:
                print('errore: path traversal rilevato: {0}'.format(f), file=sys.stderr)
                sys.exit(2)
            file_list.append(f)
    if not file_list:
        print('errore: file vuoti per --file', file=sys.stderr)
        sys.exit(2)

    # Validazione tentativi (1-5) con gestione ValueError
    try:
        tentativi = int(tentativi_arg)
    except ValueError:
        print('errore: tentativi deve essere un numero intero', file=sys.stderr)
        sys.exit(2)
    if tentativi < 1 or tentativi > 5:
        print('errore: tentativi deve essere tra 1 e 5', file=sys.stderr)
        sys.exit(2)

    if not verifica_arg or not verifica_arg.strip():
        print('errore: verifica vuota per --verifica', file=sys.stderr)
        sys.exit(2)

    # Sanitizza verifica_arg: solo caratteri alfanumerici, spazi, punti, virgole, trattini
    # Rimuove caratteri pericolosi per evitare injection
    verifica_sanitized = re.sub(r'[^a-zA-Z0-9_\-\./: \(\);|&$*]', '', verifica_arg)
    if len(verifica_sanitized) == 0 or len(verifica_sanitized) < len(verifica_arg):
        print('errore: caratteri non consentiti nel comando di verifica', file=sys.stderr)
        sys.exit(2)

    # Costruisci argv per il comando agente
    argv, env, cwd = comando(nome, compito, cartella, radice, pi)

    # Esegui pi con l'ambiente corrente più PI_CODING_AGENT_DIR
    if not os.path.isdir(cwd):
        print('errore: cartella inesistente: {0}'.format(cwd), file=sys.stderr)
        sys.exit(2)

    # Esegui il comando con timeout per evitare blocco infinito
    env_full = dict(os.environ, **env)
    try:
        subprocess.run(argv, env=env_full, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=120)
    except subprocess.TimeoutExpired:
        print('errore: timeout superato', file=sys.stderr)
        sys.exit(2)

    # Costruisci Esecuzione per il ciclo (timeout gestito da ciclo.esegui)
    # Passa una funzione lambda come esegui, che restituisce [sys.executable, 'bin/agente']
    esecuzione = Esecuzione(radice, lambda: [sys.executable, os.path.join(DEFAULT_RADICE, 'bin', 'agente')], tempo=60)

    # Esegui ciclo.esegui
    risultato = ciclo.esegui(
        compito=' '.join(compito) if isinstance(compito, list) else compito,
        cartella=cwd,
        verifica=verifica_sanitized,
        file=file_list,
        tentativi=tentativi,
        lancia=esecuzione.lancia,
        verifica_fn=esecuzione.verifica,
        lezioni=esecuzione.lezioni
    )

    return risultato


def main():
    """Main: parse degli argomenti e esecuzione del comando."""
    parser = argparse.ArgumentParser(
        description='Esecutore del comando agente: avvia pi con un profilo specifico.',
        add_help=False
    )
    parser.add_argument('nome', nargs='?', help='nome del profilo')
    parser.add_argument('compito', nargs='*', help='compito da eseguire')
    parser.add_argument('--cartella', help='cartella di lavoro')
    parser.add_argument('--file', help='lista di file separati da virgola per --verifica')
    parser.add_argument('--verifica', help='comando di verifica da passare a ciclo.esegui')
    parser.add_argument('--tentativi', type=int, default=3, help='numero di tentativi (1-5, default 3)')
    parser.add_argument('--json', action='store_true', help='output JSON')
    parser.add_argument('--aiuto', action='store_true', help='mostra aiuto e usa argparse')

    args = parser.parse_args()

    if args.aiuto:
        parser.print_help()
        sys.exit(0)

    # Se ci sono opzioni di verifica, usa il nuovo percorso
    if args.verifica:
        if not args.file:
            print('errore: --file richiesto con --verifica', file=sys.stderr)
            sys.exit(2)
        if args.nome is None:
            print('errore: nome del profilo richiesto', file=sys.stderr)
            sys.exit(2)
        if not args.compito:
            print('errore: compito richiesto', file=sys.stderr)
            sys.exit(2)

        risultato = _esegui_con_verifica(
            args.file, args.verifica, args.tentativi,
            args.nome, args.compito,
            args.cartella or os.getcwd(),
            os.environ.get('AGENTE_RADICE', DEFAULT_RADICE),
            os.environ.get('AGENTE_PI', DEFAULT_PI)
        )

        if args.json:
            _stampa_json(risultato)
        else:
            print('esito: {0}'.format(risultato['esito']))
            print('tentativi: {0}'.format(len(risultato['tentativi'])))
            print('file: {0}'.format(', '.join(risultato['file'])))

        if risultato['esito'] == 'fatto':
            sys.exit(0)
        else:
            sys.exit(1)

    # Altrimenti usa il vecchio percorso
    cartella = args.cartella
    nome = args.nome
    compito = args.compito

    if nome is None:
        print('errore: nome del profilo richiesto', file=sys.stderr)
        sys.exit(1)

    if not compito:
        print('errore: compito richiesto', file=sys.stderr)
        sys.exit(1)

    # Determina la radice (default: cartella sopra bin/)
    radice = os.environ.get('AGENTE_RADICE', DEFAULT_RADICE)
    pi = os.environ.get('AGENTE_PI', DEFAULT_PI)

    # Se --cartella non specificato, usa la cartella corrente
    if cartella is None:
        cartella = os.getcwd()

    try:
        argv, env, cwd = comando(nome, compito, cartella, radice, pi)
    except ValueError as e:
        print('errore: {0}'.format(e), file=sys.stderr)
        sys.exit(1)

    # Esegui pi con l'ambiente corrente più PI_CODING_AGENT_DIR e ne restituisce il codice di uscita
    if not os.path.isdir(cwd):
        print('errore: cartella inesistente: {0}'.format(cwd), file=sys.stderr)
        sys.exit(1)

    sys.exit(subprocess.run(argv, env=dict(os.environ, **env), cwd=cwd).returncode)


if __name__ == '__main__':
    main()
